{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sentinela-api-eavd.onrender.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://sentinela-api-eavd.onrender.com/docs"
    },
    {
      "source": "/redoc",
      "destination": "https://sentinela-api-eavd.onrender.com/redoc"
    },
    {
      "source": "/openapi.json",
      "destination": "https://sentinela-api-eavd.onrender.com/openapi.json"
    }
  ]
}
