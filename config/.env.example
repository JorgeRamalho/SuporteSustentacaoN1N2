# Copie para .env na raiz do projeto:  copy config\.env.example .env
# Segredos ficam só na sua máquina (arquivo .env não vai para o Git).
SIMULATE=true
ALLOW_REAL_ACTIONS=false
DISK_THRESHOLD=85
MEMORY_THRESHOLD=90

# Banco. Vazio usa SQLite em data/sentinela.db.
# Produção: postgresql+psycopg://usuario:senha@host:5432/sentinela
DATABASE_URL=

# Alertas. Com SIMULATE=true nada é enviado à rede.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# E-mail do relatório semanal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sentinela@empresa.local
REPORT_EMAIL_TO=sustentacao@empresa.local

# Conectores. Sem URL e token, o laboratório usa chamados de demonstração.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
SERVICENOW_BASE_URL=
SERVICENOW_TOKEN=
GLPI_BASE_URL=
GLPI_TOKEN=
ZENDESK_BASE_URL=
ZENDESK_EMAIL=
ZENDESK_TOKEN=
